<?xml version="1.0" encoding="utf-8"?>
<!-- O2OAgent mark: two interlocking O rings (online + offline) joined by a bridge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Left "O" (online) -->
    <path
        android:pathData="M23,54 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0"
        android:strokeColor="#22D3EE"
        android:strokeWidth="6"
        android:fillColor="@android:color/transparent" />
    <!-- Right "O" (offline) -->
    <path
        android:pathData="M53,54 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0"
        android:strokeColor="#6366F1"
        android:strokeWidth="6"
        android:fillColor="@android:color/transparent" />
    <!-- Bridge between the two O's -->
    <path
        android:pathData="M49,54 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#FFFFFFFF" />
</vector>
